# JARVIS Android AI Assistant Configuration
# Copy this file to .env and fill in your values

# ============================================
# Brain Configuration
# ============================================
BRAIN_WAKE_WORD=jarvis
BRAIN_MAX_MEMORY_GB=2.0
BRAIN_MIN_CONFIDENCE=0.7
BRAIN_LEARNING_ENABLED=true
BRAIN_CLOUD_SYNC_ENABLED=true
BRAIN_PRIVACY_MODE=true
BRAIN_DEBUG_MODE=false

# ============================================
# API Keys (Optional - for cloud services)
# ============================================
# Groq API
GROQ_API_KEY=

# SiliconFlow API
SILICONFLOW_API_KEY=

# OpenAI API (for ChatGPT)
OPENAI_API_KEY=

# YouTube API
YOUTUBE_API_KEY=

# Google API
GOOGLE_API_KEY=

# ============================================
# Mega Cloud Storage
# ============================================
MEGA_EMAIL=
MEGA_PASSWORD=
MEGA_ROOT_FOLDER=JARVIS_Knowledge

# ============================================
# Device Configuration
# ============================================
DEVICE_MIN_RAM_GB=3
DEVICE_MIN_STORAGE_GB=10
DEVICE_ARCHITECTURE=ARM64

# ============================================
# Termux Configuration
# ============================================
TERMUX_HOME=/data/data/com.termux/files/home
TERMUX_PROJECT_DIR=$TERMUX_HOME/Assistant
TERMUX_PYTHON=python

# ============================================
# Server Configuration
# ============================================
PYTHON_SERVER_HOST=127.0.0.1
PYTHON_SERVER_PORT=8000
BRIDGE_SERVER_PORT=8080
WEB_SOCKET_PORT=8081

# ============================================
# Network Configuration
# ============================================
NETWORK_TIMEOUT_SECONDS=30
NETWORK_RETRY_COUNT=3
NETWORK_CACHE_ENABLED=true
NETWORK_CACHE_SIZE_MB=100

# ============================================
# Logging Configuration
# ============================================
LOG_LEVEL=INFO
LOG_FILE_ENABLED=true
LOG_CONSOLE_ENABLED=true
LOG_MAX_FILE_SIZE_MB=10
LOG_MAX_FILES=5

# ============================================
# Privacy Configuration
# ============================================
PRIVACY_ENCRYPTION_ENABLED=true
PRIVACY_DATA_MASKING=true
PRIVACY_USER_CONSENT_REQUIRED=true
