        for match in matches:
            entities.append(ExtractedEntity(
                value=match.group(),
                entity_type=EntityType.DATE,
                confidence=0.9,
                start_pos=match.start(),
                end_pos=match.end(),
                metadata={"format": "DD/MM/YYYY or MM/DD/YYYY"}
            ))
        
        return entities
    
